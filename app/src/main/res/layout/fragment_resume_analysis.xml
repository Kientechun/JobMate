<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOverviewTitle"
            style="@style/TextAppearance.JobMate.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/analysis_overview" />

        <TextView
            android:id="@+id/tvOverview"
            style="@style/TextAppearance.JobMate.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/TextAppearance.JobMate.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/analysis_strengths" />

        <TextView
            android:id="@+id/tvStrengths"
            style="@style/TextAppearance.JobMate.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/TextAppearance.JobMate.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/analysis_improvements" />

        <TextView
            android:id="@+id/tvImprovements"
            style="@style/TextAppearance.JobMate.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/TextAppearance.JobMate.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/analysis_suggestions" />

        <TextView
            android:id="@+id/tvSuggestions"
            style="@style/TextAppearance.JobMate.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnViewRecommendations"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/recommendations_title" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <include
            android:id="@+id/errorLayout"
            layout="@layout/layout_error_retry" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
