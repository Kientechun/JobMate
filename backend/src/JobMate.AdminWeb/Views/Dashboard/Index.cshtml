@model JobMate.AdminWeb.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "System Overview";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card card-custom bg-white p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Candidates</div>
                    <h2 class="mb-0 fw-bold">@Model.TotalCandidates</h2>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded">
                    <i class="bi bi-people text-primary fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-success"><i class="bi bi-arrow-up"></i> 12% increase</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-white p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Company Partners</div>
                    <h2 class="mb-0 fw-bold">@Model.TotalCompanies</h2>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded">
                    <i class="bi bi-building text-info fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">Verified: 12</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-white p-4 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Pending Approval</div>
                    <h2 class="mb-0 fw-bold">@Model.PendingJobs</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded">
                    <i class="bi bi-hourglass-split text-warning fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small"><a asp-controller="JobsReview" asp-action="Index" class="text-warning text-decoration-none fw-bold">Review Now &rarr;</a></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom bg-white p-4 border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Applications</div>
                    <h2 class="mb-0 fw-bold">@Model.TotalApplications</h2>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded">
                    <i class="bi bi-file-earmark-text text-danger fs-4"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">Across @Model.TotalJobs jobs</div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card card-custom p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold">Registration Growth</h5>
                <select class="form-select form-select-sm w-auto">
                    <option>Last 6 Months</option>
                    <option>Last Year</option>
                </select>
            </div>
            <canvas id="growthChart" height="300"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4 bg-white h-100">
            <h5 class="fw-bold mb-4">Job Categories Distribution</h5>
            <canvas id="categoryChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('growthChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov'],
                datasets: [{
                    label: 'New Users',
                    data: [65, 59, 80, 81, 56, 55],
                    fill: true,
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        const ctx2 = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['IT', 'Marketing', 'Sales', 'Design'],
                datasets: [{
                    data: [45, 25, 20, 10],
                    backgroundColor: ['#dc3545', '#0d6efd', '#ffc107', '#198754']
                }]
            },
            options: { cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });
    </script>
}
