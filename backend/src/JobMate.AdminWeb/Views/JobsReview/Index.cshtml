@model IEnumerable<JobMate.Domain.Entities.Job>
@{
    ViewData["Title"] = "Job Approvals";
}

<div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4">
    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
    <div>
        <strong>Heads up!</strong> There are @Model.Count() jobs waiting for your review. Please ensure they meet JobMate's community guidelines.
    </div>
</div>

<div class="card card-custom p-0 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Job Info</th>
                    <th>Company</th>
                    <th>Category</th>
                    <th>Posted Date</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@job.Title</div>
                            <div class="text-muted small">@job.Location | @job.JobType</div>
                        </td>
                        <td>@job.CompanyName</td>
                        <td><span class="badge bg-secondary">@(job.Category?.Name ?? "N/A")</span></td>
                        <td>@job.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end pe-4">
                            <button type="button" class="btn btn-sm btn-outline-dark me-2" onclick="viewDetails(@job.Id)">
                                <i class="bi bi-eye"></i> View
                            </button>
                            <form asp-action="Approve" asp-route-id="@job.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-check-lg"></i> Approve
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger" onclick="openRejectModal(@job.Id)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            No pending jobs found. Well done!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Reject" method="post">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Reject Job Posting</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectJobId" />
                    <div class="mb-3">
                        <label class="form-label">Reason for Rejection</label>
                        <textarea name="reason" class="form-control" rows="4" placeholder="Briefly explain why this job is being rejected..." required></textarea>
                    </div>
                    <p class="text-muted small">The recruiter will be notified of this reason.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Reject</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(id) {
            $('#rejectJobId').val(id);
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }
        function viewDetails(id) {
            // Implement view logic or redirect
        }
    </script>
}
