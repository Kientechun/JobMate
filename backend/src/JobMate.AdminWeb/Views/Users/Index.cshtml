@model IEnumerable<JobMate.Infrastructure.Identity.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="row mb-4">
    <div class="col-md-6">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control border-start-0" placeholder="Search by name, email or role...">
        </div>
    </div>
</div>

<div class="card card-custom p-0 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-uppercase">
                <tr>
                    <th class="ps-4" style="font-size: 0.75rem;">User</th>
                    <th style="font-size: 0.75rem;">Email</th>
                    <th style="font-size: 0.75rem;">Join Date</th>
                    <th style="font-size: 0.75rem;">Status</th>
                    <th class="text-end pe-4" style="font-size: 0.75rem;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@user.UserName&background=random" class="rounded-circle me-3" width="35">
                                <div>
                                    <div class="fw-bold">@user.UserName</div>
                                    <div class="text-muted small">ID: @user.Id.Substring(0, 8)...</div>
                                </div>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>@DateTime.Now.AddMonths(-2).ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now)
                            {
                                <span class="badge bg-danger">Suspended</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now)
                            {
                                <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Lock" asp-route-id="@user.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Suspend</button>
                                </form>
                            }
                            <button class="btn btn-sm btn-light ms-2"><i class="bi bi-three-dots-vertical"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
