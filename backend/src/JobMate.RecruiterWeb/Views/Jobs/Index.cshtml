@model IEnumerable<JobMate.Domain.Entities.Job>
@{
    ViewData["Title"] = "My Job Postings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>@ViewData["Title"]</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i> Post New Job
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Job Details</th>
                        <th>Category</th>
                        <th>Applicants</th>
                        <th>Status</th>
                        <th>Posted Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@item.Title</div>
                                <div class="text-muted small">@item.Location | @item.JobType</div>
                            </td>
                            <td>@(item.Category?.Name ?? "N/A")</td>
                            <td>
                                <a asp-controller="Applicants" asp-action="JobApplicants" asp-route-jobId="@item.Id" class="text-decoration-none">
                                    <span class="badge bg-info text-dark">@item.Applications.Count Candidates</span>
                                </a>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case JobMate.Domain.Enums.JobStatus.Published:
                                        <span class="badge bg-success">Active</span>
                                        break;
                                    case JobMate.Domain.Enums.JobStatus.Pending:
                                        <span class="badge bg-warning text-dark">Pending Approval</span>
                                        break;
                                    case JobMate.Domain.Enums.JobStatus.Draft:
                                        <span class="badge bg-secondary">Draft</span>
                                        break;
                                    case JobMate.Domain.Enums.JobStatus.Closed:
                                        <span class="badge bg-danger">Closed</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No job postings found. Click "Post New Job" to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this job posting? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            $('#deleteId').val(id);
            var myModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            myModal.show();
        }
    </script>
}
