@model JobMate.RecruiterWeb.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card card-stat bg-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Total Jobs</h6>
                    <h3 class="mb-0">@Model.TotalJobs</h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded">
                    <i class="bi bi-briefcase text-primary fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Active Jobs</h6>
                    <h3 class="mb-0 text-success">@Model.ActiveJobs</h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded">
                    <i class="bi bi-check-circle text-success fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">New Applications</h6>
                    <h3 class="mb-0 text-warning">@Model.NewApplications</h3>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded">
                    <i class="bi bi-person-plus text-warning fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Total Applicants</h6>
                    <h3 class="mb-0 text-info">@Model.TotalApplications</h3>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded">
                    <i class="bi bi-people text-info fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="mb-4">Recent Job Postings</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Status</th>
                            <th>Applicants</th>
                            <th>Date Posted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* To be populated from database *@
                        <tr>
                            <td colspan="5" class="text-center text-muted">No recent jobs found</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="mb-4">Upcoming Interviews</h5>
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 mb-3 d-block"></i>
                No interviews scheduled
            </div>
        </div>
    </div>
</div>
